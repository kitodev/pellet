# MySQL connection (XAMPP default: user root, no password)
DATABASE_URL=mysql://root:@127.0.0.1:3306/pellet
# Product images folder – shared with the website (C:\pellet\uploads)
UPLOADS_DIR=../uploads

# Website address for "view on site" links (default http://localhost:8080)
NEXT_PUBLIC_SITE_URL=http://localhost:8080
