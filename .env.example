# MySQL (optional – default is XAMPP: mysql://root:@127.0.0.1:3306/pellet)
# TiDB Cloud: mysql://<USER>:<PASSWORD>@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/pellet
# (encrypted connection is switched on automatically for *.tidbcloud.com; elsewhere: DB_SSL=true)
DATABASE_URL=mysql://root:@127.0.0.1:3306/pellet
# Product images folder, shared with the admin app (default ./uploads)
UPLOADS_DIR=./uploads

# Old Supabase project – only needed once for `pnpm db:migrate-data`
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public address of the site, used in /sitemap.xml (default: the request host)
# SITE_URL=https://www.sajat-domain.hu

# E-mail sending for Árajánlatkérés (quote requests). Gmail: use an *app password*
# (Google-fiók → Biztonság → Kétlépcsős azonosítás → Alkalmazásjelszavak).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=pelletcentrumkft@gmail.com
SMTP_PASS=
# Where quote requests are sent (default pelletcentrumkft@gmail.com)
QUOTE_TO=pelletcentrumkft@gmail.com
# MAIL_FROM="Pellet Centrum Kft. <pelletcentrumkft@gmail.com>"
