# MySQL (optional – default is XAMPP: mysql://root:@127.0.0.1:3306/pellet)
DATABASE_URL=mysql://root:@127.0.0.1:3306/pellet
# Product images folder, shared with the admin app (default ./uploads)
UPLOADS_DIR=./uploads

# Old Supabase project – only needed once for `pnpm db:migrate-data`
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public address of the site, used in /sitemap.xml (default: the request host)
# SITE_URL=https://www.sajat-domain.hu
